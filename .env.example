# Copy to .env and fill in. .env is git-ignored; the key never reaches the browser.
# Get a free key at https://aistudio.google.com/apikey

# --- Gemini (AI explainer) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=512
# 2.5 Flash "thinking" tokens: 0 = off (fast, saves free quota), -1 = dynamic
GEMINI_THINKING_BUDGET=0
# Free tier is ~10 requests/min: keep calls at least this many seconds apart
GEMINI_MIN_INTERVAL=6.5

# --- Explainer behaviour ---
DEFAULT_LEVEL=student          # beginner | student | researcher
MAX_INPUT_CHARS=12000

# --- Server ---
HOST=127.0.0.1
PORT=5173

# --- Logging / debugging ---
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
DEBUG=1                        # enables /api/debug/* and debug/debug.html
DEBUG_DUMP=0                   # 1 = save every prompt+response to debug/dumps/

# --- arXiv etiquette (fetch_paper.py) ---
ARXIV_CONTACT=you@example.com  # put a real contact in the User-Agent
ARXIV_DELAY=3
